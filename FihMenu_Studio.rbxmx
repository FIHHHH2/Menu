        hudSongLbl = sLbl

        local aLbl = Instance.new("TextLabel")
        aLbl.Size                  = UDim2.new(1, 0, 0, 14)
        aLbl.Position              = UDim2.new(0, 0, 0, 20)
        aLbl.BackgroundTransparency = 1
        aLbl.Text                  = currentTrack.artist .. " [" .. currentTrack.source .. "]"
        aLbl.TextColor3            = C.Accent
